{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/alinhadores-invisiveis-vitoria/index.html",
        "http://localhost/facetas-lentes-de-contato-vitoria/index.html",
        "http://localhost/implante-dentario-vitoria/index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 3,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance", "accessibility", "seo", "best-practices"]
      }
    },
    "assert": {
      "assertions": {
        "resource-summary:image:size": ["error", { "maxNumericValue": 256000 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 1200000 }],

        "modern-image-formats": ["error", { "maxLength": 0 }],
        "unsized-images": ["error", { "maxLength": 0 }],
        "offscreen-images": ["error", { "maxLength": 0 }],

        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],

        "largest-contentful-paint": ["warn", { "maxNumericValue": 4000 }],
        "speed-index": ["warn", { "maxNumericValue": 5000 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }],

        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.7 }],

        "target-size": ["error", { "maxLength": 0 }],
        "image-alt": ["error", { "maxLength": 0 }],
        "meta-description": ["error", { "maxLength": 0 }],
        "document-title": ["error", { "maxLength": 0 }],
        "html-has-lang": ["error", { "maxLength": 0 }],

        "uses-http2": "off",
        "uses-long-cache-ttl": "off",
        "render-blocking-resources": "off",
        "font-display": "off",
        "canonical": "off",
        "is-crawlable": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
